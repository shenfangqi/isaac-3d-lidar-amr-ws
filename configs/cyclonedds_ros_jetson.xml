<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <!-- Physical-robot DDS is opt-in and uses the workstation Wi-Fi LAN. -->
      <Interfaces>
        <NetworkInterface name="wlp8s0" multicast="true"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>

    <Discovery>
      <!-- Keep discovery working when the access point filters multicast. -->
      <Peers>
        <!-- Containers do not currently have mDNS NSS; update after DHCP changes. -->
        <Peer Address="192.168.1.109"/>
      </Peers>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
