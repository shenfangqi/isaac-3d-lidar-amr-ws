[Unit]
Description=Carbot MID-360 software-timestamp PTP master
Documentation=man:ptp4l(8)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/sys/class/net/enP8p1s0

[Service]
Type=simple
ExecStart=/usr/sbin/ptp4l -f /etc/linuxptp/carbot-mid360-ptp.cfg -i enP8p1s0 -m
Restart=on-failure
RestartSec=2

# ptp4l needs the PTP event/general UDP ports, raw/software timestamping, and
# access to publish the system-clock status used by a software master.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_TIME
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_TIME
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=carbot-mid360-ptp
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
