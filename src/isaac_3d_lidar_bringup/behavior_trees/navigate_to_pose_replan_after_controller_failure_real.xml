<!--
  Issue #1, real robot: compute one global path and keep it while the local
  controller makes progress.  Raw /scan in the local costmap still provides
  immediate collision stopping.  If FollowPath fails, wait for a transient
  obstacle to leave and retry the unchanged path once; if it fails again,
  compute exactly one global detour against the filtered global costmap.

  Unlike the simulation tree, no costmap is cleared before the detour.  The
  real /scan has a 0.5 m minimum range and RPP stops with the obstacle about
  0.26-0.40 m from the base, inside that blind zone.  A cleared cell there
  cannot be observed again: the local controller would lose the obstacle and
  the replan would return the same blocked path.  The global costmap keeps
  the obstacle marked while it was still visible during the approach.

  IsPathValid, PipelineSequence/RateController and Spin/BackUp are
  intentionally absent; see configs/behavior_trees for the reasoning.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- A memory Sequence does not tick ComputeInitialPath again while
         FollowPath is RUNNING.  There is no outer recovery loop: after one
         unchanged-path retry and one global replan, failure terminates. -->
    <Sequence name="NavigateWithFailureTriggeredReplanning">
      <!-- Before the robot has moved, a failed initial plan may be caused by
           a stale global obstacle; clearing is safe because nothing is yet
           close enough to fall into the blind zone unobserved. -->
      <RecoveryNode number_of_retries="1" name="ComputeInitialPath">
        <ComputePathToPose
          goal="{goal}"
          path="{path}"
          planner_id="GridBased"/>
        <ClearEntireCostmap
          name="ClearGlobalCostmapPlanning"
          service_name="global_costmap/clear_entirely_global_costmap"/>
      </RecoveryNode>
      <RecoveryNode number_of_retries="1" name="FollowAndReplanOnPersistentFailure">
        <RecoveryNode number_of_retries="1" name="FollowAfterTransientPause">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Wait wait_duration="2"/>
        </RecoveryNode>
        <Sequence name="PersistentObstacleReplan">
          <!-- Let the five-frame filtered scan settle while stationary. -->
          <Wait wait_duration="2"/>
          <ComputePathToPose
            goal="{goal}"
            path="{path}"
            planner_id="GridBased"/>
        </Sequence>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
