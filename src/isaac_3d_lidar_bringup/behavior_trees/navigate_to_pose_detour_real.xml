<!--
  Issue #1 detour.  Off by default on the robot; the launch argument
  novel_obstacle_detour:=true enables it for operator-supervised tests.
  Compute one global path and keep it while the controller makes progress.

  Issue #123: while driving, the next 4 m of the route (the keep-off is
  marked up to 4 m away) is checked against the global costmap on every tick
  (TruncatePathLocal + IsPathValid).  When a novel obstacle's keep-off
  crosses it, FollowPath is halted at once, however far away the obstacle
  is, and the robot waits 3 s.  If the route ahead is clear again (a person
  walked past) the robot continues on the unchanged path; otherwise a detour
  is planned without backing away.  When no detour can be planned, the
  robot stays stopped and every 3 s continues on the current path if its
  route ahead is clear, or adopts a path that can now be planned.  These
  stops and detours are not counted.  The global costmap uses a robot
  radius (carbot_obstacle_detour_real.yaml), so IsPathValid fails only on
  lethal or inscribed cells at the path centre: the saved map's walls never
  stop a path Smac2D planned around them.

  On a FollowPath failure with the route ahead clear (RPP refused to drive
  into an obstacle the keep-off has not marked, e.g. a corner), wait 2 s
  and retry the unchanged path once.  If it fails again, back away with
  reverse_escape (0.10 m back, or ahead when a wall is behind;
  reverse_escape.py), wait 2 s and compute a new path.  An escape that
  cannot move does not end the goal.  At most three escapes per goal: in a
  gap the planner accepts and RPP refuses, unbounded escapes rocked the
  robot 0.10 m back and forth (Isaac, 0.6 m gap).  After the third, a
  refusal only waits: every 3 s a path is planned again (the current one
  is kept if none can be) and driven, still stopping and detouring for
  route blocks as above.

  The goal therefore never aborts by itself after the first path: it ends
  when the goal is reached or the operator cancels it (the halt cancels the
  running Wait and FollowPath).  Every Wait increments the navigation
  feedback's number_of_recoveries and the behavior server logs
  "Running wait".  (2026-10-19: a shared budget of three for both kinds was
  used up by a box's growing keep-off, leaving no escape for a corner.)

  Detours are planned against the global costmap's novel-obstacle keep-off
  layer (novel_obstacle_keepoff): an obstacle absent from the saved map is
  given an assumed depth and a keep-off (carbot_obstacle_detour_real.yaml).

  No costmap is cleared, PipelineSequence/RateController and Spin are
  intentionally absent, and the only motion besides FollowPath is
  reverse_escape, at most three times.  The large retry counts only stand
  for "unbounded": each pass waits at least 2 s.
-->
<root main_tree_to_execute="MainTree">
  <!--
    A new goal sent while one runs (same tree) only replaces {goal}: Humble
    keeps ticking this tree (2026-10-20 robot: new goals were ignored while
    the robot waited at the sofa corner).  On any goal change, halt
    everything and start over from a new plan.  GlobalUpdatedGoal also
    reports the first tick of each goal as a change, which costs one
    restart before anything runs.  goal_changed tells that restart from an
    initial plan failure, which still aborts.
  -->
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="1000000" name="RestartOnNewGoal">
      <ReactiveSequence name="NavigateUntilGoalChanges">
        <Fallback name="SameGoal">
          <Inverter>
            <GlobalUpdatedGoal/>
          </Inverter>
          <Sequence>
            <SetBlackboard output_key="goal_changed" value="true"/>
            <AlwaysFailure/>
          </Sequence>
        </Fallback>
        <SubTree ID="Navigate" __shared_blackboard="true"/>
      </ReactiveSequence>
      <BlackboardCheckString value_A="{goal_changed}" value_B="true"
                             return_on_mismatch="FAILURE">
        <SetBlackboard output_key="goal_changed" value="false"/>
      </BlackboardCheckString>
    </RecoveryNode>
  </BehaviorTree>

  <BehaviorTree ID="Navigate">
    <Sequence name="NavigateWithBoundedEscapes">
      <ComputePathToPose
        goal="{goal}"
        path="{path}"
        planner_id="GridBased"/>
      <Fallback name="EscapeOrWait">
        <RecoveryNode number_of_retries="3" name="EscapeBudget">
          <SubTree ID="DetourAroundBlocks" __shared_blackboard="true"/>
          <Sequence name="Escape">
            <ForceSuccess>
              <BackUp backup_dist="0.10" backup_speed="0.05" time_allowance="6.0"
                      server_name="reverse_escape"/>
            </ForceSuccess>
            <!-- Let the keep-off evidence settle while stationary. -->
            <Wait wait_duration="2"/>
            <SubTree ID="PlanOrWait" __shared_blackboard="true"/>
          </Sequence>
        </RecoveryNode>
        <RetryUntilSuccessful num_attempts="-1" name="WaitAfterEscapeBudget">
          <Sequence>
            <Wait wait_duration="3"/>
            <!-- Replan (no escape) so a changed scene is used; keep the
                 current path if nothing can be planned. -->
            <ForceSuccess>
              <ComputePathToPose
                goal="{goal}"
                path="{path}"
                planner_id="GridBased"/>
            </ForceSuccess>
            <SubTree ID="DetourAroundBlocks" __shared_blackboard="true"/>
          </Sequence>
        </RetryUntilSuccessful>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!--
    Drive {path}; when its route ahead stays blocked, plan a detour (no
    escape, not counted).  Fails only when FollowPath fails twice with the
    route ahead clear.
  -->
  <BehaviorTree ID="DetourAroundBlocks">
    <RecoveryNode number_of_retries="1000000" name="DetourWhileBlocked">
      <SubTree ID="FollowRoute" __shared_blackboard="true"/>
      <Sequence name="BlockedDetour">
        <Inverter>
          <SubTree ID="RouteAheadClear" __shared_blackboard="true"/>
        </Inverter>
        <SubTree ID="PlanOrWait" __shared_blackboard="true"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>

  <!--
    Plan a new {path}; while that fails, stay stopped and every 3 s accept
    the current path if its route ahead is clear, or plan again.
  -->
  <BehaviorTree ID="PlanOrWait">
    <Fallback>
      <ComputePathToPose
        goal="{goal}"
        path="{path}"
        planner_id="GridBased"/>
      <RetryUntilSuccessful num_attempts="-1" name="WaitForRoute">
        <Sequence>
          <Wait wait_duration="3"/>
          <Fallback>
            <SubTree ID="RouteAheadClear" __shared_blackboard="true"/>
            <ComputePathToPose
              goal="{goal}"
              path="{path}"
              planner_id="GridBased"/>
          </Fallback>
        </Sequence>
      </RetryUntilSuccessful>
    </Fallback>
  </BehaviorTree>

  <!--
    Drive {path}, pausing while its route ahead is blocked.  Fails when the
    route is still blocked after the 3 s pause, or when FollowPath fails
    twice with the route clear.
  -->
  <BehaviorTree ID="FollowRoute">
    <RecoveryNode number_of_retries="1000000" name="PauseWhileBlocked">
      <RecoveryNode number_of_retries="1" name="FollowAfterTransientPause">
        <ReactiveSequence name="FollowWhileRouteAheadClear">
          <SubTree ID="RouteAheadClear" __shared_blackboard="true"/>
          <FollowPath path="{path}" controller_id="FollowPath"/>
        </ReactiveSequence>
        <Sequence name="TransientPause">
          <SubTree ID="RouteAheadClear" __shared_blackboard="true"/>
          <Wait wait_duration="2"/>
        </Sequence>
      </RecoveryNode>
      <Sequence name="BlockedPause">
        <Inverter>
          <SubTree ID="RouteAheadClear" __shared_blackboard="true"/>
        </Inverter>
        <Wait wait_duration="3"/>
        <SubTree ID="RouteAheadClear" __shared_blackboard="true"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>

  <!-- The next 4 m of {path} from the pose closest to the robot. -->
  <BehaviorTree ID="RouteAheadClear">
    <Sequence>
      <TruncatePathLocal input_path="{path}" output_path="{path_ahead}"
                         distance_forward="4.0" distance_backward="0.0"
                         robot_frame="base_footprint"/>
      <IsPathValid path="{path_ahead}"/>
    </Sequence>
  </BehaviorTree>
</root>
